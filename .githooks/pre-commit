#!/bin/sh
# Stamps a new release into version.json, which index.html uses to load every
# file as one matched set. Enable once per clone:
#   git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
modules=$(cd js && ls ./*.js | sed 's|^\./\(.*\)$|"\1"|' | paste -sd, -)
printf '{"v":"%s","modules":[%s]}\n' "$(date +%s)" "$modules" > version.json
git add version.json
