[
{"id":"s01","en":"I am a student.","note":"は marks 私 as the topic. です closes the sentence.","blocks":[{"t":"私","y":"わたし","r":"topic"},{"t":"は","r":"particle"},{"t":"学生","y":"がくせい","r":"other"},{"t":"です","r":"verb"}]},
{"id":"s02","en":"I eat sushi.","note":"を marks すし as the thing being eaten.","blocks":[{"t":"私","y":"わたし","r":"topic"},{"t":"は","r":"particle"},{"t":"すし","r":"object"},{"t":"を","r":"particle"},{"t":"食べます","y":"たべます","r":"verb"}]},
{"id":"s03","en":"I go to school.","note":"に marks 学校 as the destination. へ would also work here.","blocks":[{"t":"私","y":"わたし","r":"topic"},{"t":"は","r":"particle"},{"t":"学校","y":"がっこう","r":"other"},{"t":"に","r":"particle"},{"t":"行きます","y":"いきます","r":"verb"}]},
{"id":"s04","en":"I read a book at the library.","note":"で marks where the action happens. The で and を phrases can swap places.","blocks":[{"t":"私","y":"わたし","r":"topic"},{"t":"は","r":"particle"},{"t":"図書館","y":"としょかん","r":"other"},{"t":"で","r":"particle"},{"t":"本","y":"ほん","r":"object"},{"t":"を","r":"particle"},{"t":"読みます","y":"よみます","r":"verb"}],"alts":[[0,1,4,5,2,3,6]]},
{"id":"s05","en":"A friend came.","note":"が presents 友達 as new information: someone came, and it was a friend.","blocks":[{"t":"友達","y":"ともだち","r":"subject"},{"t":"が","r":"particle"},{"t":"来ました","y":"きました","r":"verb"}]},
{"id":"s06","en":"Tomorrow I will go to the mountains with a friend.","note":"と means “with” here. Time words often come first, and the と and に phrases can swap.","blocks":[{"t":"明日","y":"あした","r":"other"},{"t":"友達","y":"ともだち","r":"other"},{"t":"と","r":"particle"},{"t":"山","y":"やま","r":"other"},{"t":"に","r":"particle"},{"t":"行きます","y":"いきます","r":"verb"}],"alts":[[0,3,4,1,2,5],[1,2,0,3,4,5]]},
{"id":"s07","en":"This is my book.","note":"の links 私 to 本: my book.","blocks":[{"t":"これ","r":"topic"},{"t":"は","r":"particle"},{"t":"私","y":"わたし","r":"other"},{"t":"の","r":"particle"},{"t":"本","y":"ほん","r":"other"},{"t":"です","r":"verb"}]},
{"id":"s08","en":"My older brother is also a student.","note":"も replaces は and adds “also”.","blocks":[{"t":"兄","y":"あに","r":"topic"},{"t":"も","r":"particle"},{"t":"学生","y":"がくせい","r":"other"},{"t":"です","r":"verb"}]},
{"id":"s09","en":"I go to Japan by plane.","note":"で marks the means of travel, and へ marks the direction. The two phrases can swap.","blocks":[{"t":"飛行機","y":"ひこうき","r":"other"},{"t":"で","r":"particle"},{"t":"日本","y":"にほん","r":"other"},{"t":"へ","r":"particle"},{"t":"行きます","y":"いきます","r":"verb"}],"alts":[[2,3,0,1,4]]},
{"id":"s10","en":"I bought a big book yesterday.","note":"大きい sits directly before the noun it describes.","blocks":[{"t":"昨日","y":"きのう","r":"other"},{"t":"大きい","y":"おおきい","r":"other"},{"t":"本","y":"ほん","r":"object"},{"t":"を","r":"particle"},{"t":"買いました","y":"かいました","r":"verb"}],"alts":[[1,2,3,0,4]]},
{"id":"s11","en":"I drink water every day.","note":"を marks 水 as what you drink. The subject “I” is simply left out.","blocks":[{"t":"毎日","y":"まいにち","r":"other"},{"t":"水","y":"みず","r":"object"},{"t":"を","r":"particle"},{"t":"飲みます","y":"のみます","r":"verb"}],"alts":[[1,2,0,3]]},
{"id":"s12","en":"My mother reads the newspaper.","note":"When talking about your own mother, use 母.","blocks":[{"t":"母","y":"はは","r":"topic"},{"t":"は","r":"particle"},{"t":"新聞","y":"しんぶん","r":"object"},{"t":"を","r":"particle"},{"t":"読みます","y":"よみます","r":"verb"}]},
{"id":"s13","en":"My father is a company employee.","note":"父 is your own father. は sets him as the topic.","blocks":[{"t":"父","y":"ちち","r":"topic"},{"t":"は","r":"particle"},{"t":"会社員","y":"かいしゃいん","r":"other"},{"t":"です","r":"verb"}]},
{"id":"s14","en":"What is your name?","note":"か at the end turns a statement into a question.","blocks":[{"t":"お名前","y":"おなまえ","r":"topic"},{"t":"は","r":"particle"},{"t":"何です","y":"なんです","r":"verb"},{"t":"か","r":"particle"}]},
{"id":"s15","en":"What time is it now?","note":"か marks the question. 何時 means “what time”.","blocks":[{"t":"今","y":"いま","r":"other"},{"t":"何時","y":"なんじ","r":"other"},{"t":"です","r":"verb"},{"t":"か","r":"particle"}]},
{"id":"s16","en":"It's rainy today.","note":"今日 is the topic: as for today, it's rain.","blocks":[{"t":"今日","y":"きょう","r":"topic"},{"t":"は","r":"particle"},{"t":"雨","y":"あめ","r":"other"},{"t":"です","r":"verb"}]},
{"id":"s17","en":"The weather is nice today.","note":"A common pattern: は sets the topic, and が marks what is being described.","blocks":[{"t":"今日","y":"きょう","r":"topic"},{"t":"は","r":"particle"},{"t":"天気","y":"てんき","r":"subject"},{"t":"が","r":"particle"},{"t":"いい","r":"other"},{"t":"です","r":"verb"}]},
{"id":"s18","en":"I listen to music at home.","note":"で marks where the listening happens, and を marks what you hear.","blocks":[{"t":"家","y":"いえ","r":"other"},{"t":"で","r":"particle"},{"t":"音楽","y":"おんがく","r":"object"},{"t":"を","r":"particle"},{"t":"聞きます","y":"ききます","r":"verb"}],"alts":[[2,3,0,1,4]]},
{"id":"s19","en":"I write a letter to my friend.","note":"に marks who receives the letter.","blocks":[{"t":"友達","y":"ともだち","r":"other"},{"t":"に","r":"particle"},{"t":"手紙","y":"てがみ","r":"object"},{"t":"を","r":"particle"},{"t":"書きます","y":"かきます","r":"verb"}],"alts":[[2,3,0,1,4]]},
{"id":"s20","en":"I met my friend at the station.","note":"会う takes に for the person you meet, not を.","blocks":[{"t":"駅","y":"えき","r":"other"},{"t":"で","r":"particle"},{"t":"友達","y":"ともだち","r":"other"},{"t":"に","r":"particle"},{"t":"会いました","y":"あいました","r":"verb"}],"alts":[[2,3,0,1,4]]},
{"id":"s21","en":"I go to work by train.","note":"で marks how you travel, and に marks where you arrive.","blocks":[{"t":"電車","y":"でんしゃ","r":"other"},{"t":"で","r":"particle"},{"t":"会社","y":"かいしゃ","r":"other"},{"t":"に","r":"particle"},{"t":"行きます","y":"いきます","r":"verb"}],"alts":[[2,3,0,1,4]]},
{"id":"s22","en":"I came to Japan last year.","note":"去年 needs no particle, unlike a specific time such as 五時.","blocks":[{"t":"去年","y":"きょねん","r":"other"},{"t":"日本","y":"にほん","r":"other"},{"t":"に","r":"particle"},{"t":"来ました","y":"きました","r":"verb"}],"alts":[[1,2,0,3]]},
{"id":"s23","en":"There is a cat under the tree.","note":"Living things take います. 木の下 is literally “the tree's underside”.","blocks":[{"t":"木","y":"き","r":"other"},{"t":"の","r":"particle"},{"t":"下","y":"した","r":"other"},{"t":"に","r":"particle"},{"t":"猫","y":"ねこ","r":"subject"},{"t":"が","r":"particle"},{"t":"います","r":"verb"}],"alts":[[4,5,0,1,2,3,6]]},
{"id":"s24","en":"There is a book on the desk.","note":"Non-living things take あります. に marks where it is.","blocks":[{"t":"机","y":"つくえ","r":"other"},{"t":"の","r":"particle"},{"t":"上","y":"うえ","r":"other"},{"t":"に","r":"particle"},{"t":"本","y":"ほん","r":"subject"},{"t":"が","r":"particle"},{"t":"あります","r":"verb"}],"alts":[[4,5,0,1,2,3,6]]},
{"id":"s25","en":"The station is over there.","note":"あそこ means a place away from both of you.","blocks":[{"t":"駅","y":"えき","r":"topic"},{"t":"は","r":"particle"},{"t":"あそこ","r":"other"},{"t":"です","r":"verb"}]},
{"id":"s26","en":"This car is new.","note":"この must sit directly before its noun.","blocks":[{"t":"この","r":"other"},{"t":"車","y":"くるま","r":"topic"},{"t":"は","r":"particle"},{"t":"新しい","y":"あたらしい","r":"other"},{"t":"です","r":"verb"}]},
{"id":"s27","en":"That shop is cheap.","note":"あの points to something away from both of you.","blocks":[{"t":"あの","r":"other"},{"t":"店","y":"みせ","r":"topic"},{"t":"は","r":"particle"},{"t":"安い","y":"やすい","r":"other"},{"t":"です","r":"verb"}]},
{"id":"s28","en":"That mountain is tall.","note":"An い-adjective can go directly before です.","blocks":[{"t":"あの","r":"other"},{"t":"山","y":"やま","r":"topic"},{"t":"は","r":"particle"},{"t":"高い","y":"たかい","r":"other"},{"t":"です","r":"verb"}]},
{"id":"s29","en":"I don't eat meat.","note":"ません makes a polite verb negative.","blocks":[{"t":"肉","y":"にく","r":"object"},{"t":"を","r":"particle"},{"t":"食べません","y":"たべません","r":"verb"}]},
{"id":"s30","en":"I didn't go to school yesterday.","note":"ませんでした is the polite past negative.","blocks":[{"t":"昨日","y":"きのう","r":"other"},{"t":"学校","y":"がっこう","r":"other"},{"t":"に","r":"particle"},{"t":"行きませんでした","y":"いきませんでした","r":"verb"}],"alts":[[1,2,0,3]]},
{"id":"s31","en":"I like Japanese.","note":"好き is an adjective, so what you like takes が.","blocks":[{"t":"日本語","y":"にほんご","r":"subject"},{"t":"が","r":"particle"},{"t":"好き","y":"すき","r":"other"},{"t":"です","r":"verb"}]},
{"id":"s32","en":"My friend is good at English.","note":"上手 also takes が for the skill.","blocks":[{"t":"友達","y":"ともだち","r":"topic"},{"t":"は","r":"particle"},{"t":"英語","y":"えいご","r":"subject"},{"t":"が","r":"particle"},{"t":"上手","y":"じょうず","r":"other"},{"t":"です","r":"verb"}]},
{"id":"s33","en":"I study Japanese every day.","note":"を marks what is studied. 毎日 takes no particle.","blocks":[{"t":"毎日","y":"まいにち","r":"other"},{"t":"日本語","y":"にほんご","r":"object"},{"t":"を","r":"particle"},{"t":"勉強します","y":"べんきょうします","r":"verb"}],"alts":[[1,2,0,3]]},
{"id":"s34","en":"I bought a new car.","note":"新しい sits directly before the noun it describes.","blocks":[{"t":"新しい","y":"あたらしい","r":"other"},{"t":"車","y":"くるま","r":"object"},{"t":"を","r":"particle"},{"t":"買いました","y":"かいました","r":"verb"}]},
{"id":"s35","en":"I rest on Sunday.","note":"Days of the week usually take に.","blocks":[{"t":"日曜日","y":"にちようび","r":"other"},{"t":"に","r":"particle"},{"t":"休みます","y":"やすみます","r":"verb"}]},
{"id":"s36","en":"I watch TV at night.","note":"を marks what you watch.","blocks":[{"t":"夜","y":"よる","r":"other"},{"t":"テレビ","r":"object"},{"t":"を","r":"particle"},{"t":"見ます","y":"みます","r":"verb"}],"alts":[[1,2,0,3]]},
{"id":"s37","en":"I go home at five o'clock.","note":"Clock times take に.","blocks":[{"t":"五時","y":"ごじ","r":"other"},{"t":"に","r":"particle"},{"t":"帰ります","y":"かえります","r":"verb"}]},
{"id":"s38","en":"There is a child in the park.","note":"A child is alive, so use います. に marks the location.","blocks":[{"t":"公園","y":"こうえん","r":"other"},{"t":"に","r":"particle"},{"t":"子ども","y":"こども","r":"subject"},{"t":"が","r":"particle"},{"t":"います","r":"verb"}],"alts":[[2,3,0,1,4]]},
{"id":"s39","en":"Is this your book?","note":"の links あなた to 本, and か makes it a question.","blocks":[{"t":"これ","r":"topic"},{"t":"は","r":"particle"},{"t":"あなた","r":"other"},{"t":"の","r":"particle"},{"t":"本","y":"ほん","r":"other"},{"t":"です","r":"verb"},{"t":"か","r":"particle"}]},
{"id":"s40","en":"My father and mother are at home.","note":"と joins the two nouns. に marks where they are.","blocks":[{"t":"父","y":"ちち","r":"topic"},{"t":"と","r":"particle"},{"t":"母","y":"はは","r":"topic"},{"t":"は","r":"particle"},{"t":"家","y":"いえ","r":"other"},{"t":"に","r":"particle"},{"t":"います","r":"verb"}]},
{"id":"s41","en":"I drink coffee with my friend.","note":"と marks who you do it with.","blocks":[{"t":"友達","y":"ともだち","r":"other"},{"t":"と","r":"particle"},{"t":"コーヒー","r":"object"},{"t":"を","r":"particle"},{"t":"飲みます","y":"のみます","r":"verb"}],"alts":[[2,3,0,1,4]]},
{"id":"s42","en":"It's cold today.","note":"寒い is an い-adjective, so it goes straight before です.","blocks":[{"t":"今日","y":"きょう","r":"topic"},{"t":"は","r":"particle"},{"t":"寒い","y":"さむい","r":"other"},{"t":"です","r":"verb"}]},
{"id":"s43","en":"I talk with the teacher in Japanese.","note":"と marks the partner. で marks the language used, which is a means.","blocks":[{"t":"先生","y":"せんせい","r":"other"},{"t":"と","r":"particle"},{"t":"日本語","y":"にほんご","r":"other"},{"t":"で","r":"particle"},{"t":"話します","y":"はなします","r":"verb"}],"alts":[[2,3,0,1,4]]},
{"id":"s44","en":"Where is the station?","note":"どこ means “where”. The word order stays the same as a statement.","blocks":[{"t":"駅","y":"えき","r":"topic"},{"t":"は","r":"particle"},{"t":"どこ","r":"other"},{"t":"です","r":"verb"},{"t":"か","r":"particle"}]},
{"id":"s45","en":"I'll go too.","note":"も replaces は and adds “too”.","blocks":[{"t":"私","y":"わたし","r":"topic"},{"t":"も","r":"particle"},{"t":"行きます","y":"いきます","r":"verb"}]},
{"id":"s46","en":"I buy flowers at the shop.","note":"で marks the place of the action, and を marks what you buy.","blocks":[{"t":"店","y":"みせ","r":"other"},{"t":"で","r":"particle"},{"t":"花","y":"はな","r":"object"},{"t":"を","r":"particle"},{"t":"買います","y":"かいます","r":"verb"}],"alts":[[2,3,0,1,4]]},
{"id":"s47","en":"This is not a book.","note":"ではありません is the polite negative of です.","blocks":[{"t":"これ","r":"topic"},{"t":"は","r":"particle"},{"t":"本","y":"ほん","r":"other"},{"t":"ではありません","r":"verb"}]},
{"id":"s48","en":"The car is outside.","note":"A car isn't alive, so use あります.","blocks":[{"t":"車","y":"くるま","r":"topic"},{"t":"は","r":"particle"},{"t":"外","y":"そと","r":"other"},{"t":"に","r":"particle"},{"t":"あります","r":"verb"}]},
{"id":"s49","en":"What do you eat in the morning?","note":"Here 何 is read なに, and を marks it as the thing eaten.","blocks":[{"t":"朝","y":"あさ","r":"other"},{"t":"何","y":"なに","r":"object"},{"t":"を","r":"particle"},{"t":"食べます","y":"たべます","r":"verb"},{"t":"か","r":"particle"}]},
{"id":"s50","en":"Let's eat lunch at the university.","note":"ましょう means “let's”.","blocks":[{"t":"大学","y":"だいがく","r":"other"},{"t":"で","r":"particle"},{"t":"昼ご飯","y":"ひるごはん","r":"object"},{"t":"を","r":"particle"},{"t":"食べましょう","y":"たべましょう","r":"verb"}],"alts":[[2,3,0,1,4]]}
]
